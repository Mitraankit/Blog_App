# Firebase — get these from Firebase Console > Project Settings > Your apps
VITE_FIREBASE_API_KEY=AIzaSy_your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:abc123

# Cloudinary — get these from Cloudinary Dashboard > Settings > Upload Presets
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
