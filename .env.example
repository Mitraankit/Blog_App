# MongoDB connection string
MONGO=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_char_random_secret_here

# SMTP — for password reset emails (use Gmail app password, Resend, or Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password_here

# Public URL of your deployed frontend (no trailing slash)
CLIENT_URL=https://yourdomain.com

# Used for sitemap.xml and robots.txt generation
SITE_URL=https://yourdomain.com
